# Lokale Entwicklung — Kopie nach .env und Werte ausfüllen.
# .env wird nicht ins Repo committet (siehe .gitignore).

# Session-Cookie-Verschlüsselung (32+ Bytes, kryptographisch sicher).
# Generieren: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-random-32-byte-secret

# Email-Versand via SMTP. Wenn NUXT_SMTP_HOST leer ist, werden Magic-Link- und
# Invite-Mails nicht verschickt, sondern auf der Konsole geloggt (Dev-Stub).
#
# Lokal mit Papercut (https://github.com/ChangemakerStudios/Papercut-SMTP):
#   NUXT_SMTP_HOST=localhost
#   NUXT_SMTP_PORT=25
#
# Produktiv mit Brevo SMTP-Relay (https://app.brevo.com → SMTP & API → SMTP):
#   NUXT_SMTP_HOST=smtp-relay.brevo.com
#   NUXT_SMTP_PORT=587
#   NUXT_SMTP_USER=<deine Brevo-Login-Email>
#   NUXT_SMTP_PASS=<SMTP-Key aus dem Brevo-Dashboard>
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=25
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Auf 'true' setzen für TLS-from-start (Port 465). STARTTLS auf 587 läuft mit 'false'.
NUXT_SMTP_SECURE=false
# Absender für ausgehende Mails. Format: "Anzeigename <adresse@host>"
NUXT_MAIL_FROM="ace · TuS Neureut <no-reply@tus-neureut.de>"

# Pfad zur SQLite-Datei. Default relativ zu app/.
NUXT_DB_PATH=./data/ace.db

# Public Base-URL — für Magic-Links und Email-Inhalte.
# Lokal: http://localhost:3000  ·  Demo: https://ace.fly.dev  ·  Produktion: https://ace.tus-neureut.de
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Magic-Link-Rate-Limit pro Email-Adresse pro Stunde.
# Spec-Default 3/h (FR-114). Für lokale Entwicklung Klick-Testen empfehlen
# wir 100, sonst beißt das Limit beim wiederholten An-/Abmelden.
NUXT_AUTH_MAGIC_LINK_LIMIT_PER_HOUR=100
